{% extends 'base.html.twig' %}
{% block title %}
    Accueil - Cours & Matériel de Musique
{% endblock %}

{% block body %}

<a href="{{ path('app_home_admin') }}">Retour</a>

<h1>Gestion des Produits</h1>

{# Add a product #}
<h2>Ajouter un produit</h2>

<form action="{{ path('app_products_admin_add') }}" method="POST" class="add-product-form">
    <input type="text" name="name" placeholder="Nom du produit" required>
    <select name="category" required>
        <option value="" disabled selected>Choisir une catégorie</option>
        <option value="guitar">Guitar</option>
        <option value="bass">Bass</option>
        <option value="other">Other</option>
    </select>
    <textarea name="description" placeholder="Description"></textarea>
    <input type="number" name="price" placeholder="Prix" step="0.01" required>
    <input type="number" name="stock" placeholder="Stock" required>
    <input type="text" name="images" placeholder='Images (ex. ["guitare.jpg"])'>

    <label>
        <input type="checkbox" name="isUsed" value="1">
        Occasion
    </label>

    <button type="submit">Ajouter le produit</button>
</form>

{# Search for a product #}
<div class="search-bar">
    <input type="text" id="searchInput" placeholder="Rechercher un produit..." onkeyup="filterTable()">
</div>

{# Display and edit products #}
<div class="table-wrapper">
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Nom</th>
                <th>Catégorie</th>
                <th>Description</th>
                <th>Prix (€)</th>
                <th>Stock</th>
                <th>Occasion</th>
                <th>Images</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for product in products %}
                <tr>
                    <td>
                        {{ product.id }}
                        <form id="form-product-{{ product.id }}"
                            action="{{ path('app_products_admin_edit', {id: product.id}) }}"
                            method="POST"></form>
                    </td>
                    <td><input type="text" name="name" value="{{ product.name }}" form="form-product-{{ product.id }}"></td>
                    <td>
                        <select name="category" form="form-product-{{ product.id }}">
                            <option value="guitar" {{ product.category == 'guitar' ? 'selected' : '' }}>Guitar</option>
                            <option value="bass" {{ product.category == 'bass' ? 'selected' : '' }}>Bass</option>
                            <option value="other" {{ product.category == 'other' ? 'selected' : '' }}>Other</option>
                        </select>
                    </td>
                    <td><textarea name="description" form="form-product-{{ product.id }}">{{ product.description }}</textarea></td>
                    <td><input type="number" step="0.01" name="price" value="{{ product.price }}" form="form-product-{{ product.id }}"></td>
                    <td><input type="number" name="stock" value="{{ product.stock }}" form="form-product-{{ product.id }}"></td>
                    <td>
                        <input type="checkbox" name="isUsed" value="1"
                            {{ product.isUsed ? 'checked' : '' }}
                            form="form-product-{{ product.id }}">
                    </td>
                    <td>
                        <input type="text" name="images"
                            value="{{ product.images is iterable ? product.images|json_encode : product.images }}"
                            form="form-product-{{ product.id }}">
                    </td>
                    <td>
                        <button type="submit" form="form-product-{{ product.id }}">Enregistrer</button>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="9">Aucun produit trouvé.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<script>
    function filterTable() {
        const filter = document.getElementById('searchInput').value.toLowerCase();
        const rows = document.querySelectorAll('table tbody tr');

        rows.forEach(row => {
            const nameInput = row.querySelector('input[name="name"]');

            if (nameInput) {
                row.style.display = nameInput.value.toLowerCase().includes(filter) ? '' : 'none';
            }
        });
    }
</script>

{% endblock %}



{% block stylesheets %}
    {{ parent() }}
    <style>
        .add-product-form {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin: 20px 0;
            padding: 15px;
            border: 1px solid #ddd;
            border-radius: 6px;
        }

        .add-product-form input,
        .add-product-form textarea {
            flex: 1 1 180px;
            padding: 8px;
        }

        .add-product-form label {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .search-bar {
            margin: 15px 0;
        }

        .table-wrapper {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th,
        td {
            padding: 8px;
            border: 1px solid #ddd;
            text-align: left;
        }

        th {
            background: #f2f2f2;
        }

        td input,
        td textarea {
            max-width: 180px;
        }
    </style>
{% endblock %}