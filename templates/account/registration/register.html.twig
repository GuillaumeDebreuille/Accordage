{% extends 'base.html.twig' %}

{% block title %}Register{% endblock %}

{% block body %}
    {# Registration form #}
    <div class="register-page">
        <div class="register-card">
            <h1>Register</h1>

            {# Display general form errors #}
            {{ form_errors(registrationForm) }}

            {{ form_start(registrationForm, {'attr': {'class': 'register-form'}}) }}
                {{ form_row(registrationForm.email) }}
                {{ form_row(registrationForm.name) }}
                {{ form_row(registrationForm.firstName) }}
                {{ form_row(registrationForm.phone) }}
                {{ form_row(registrationForm.isAdmin) }}

                {{ form_row(registrationForm.plainPassword, {
                    label: 'Password'
                }) }}

                {{ form_row(registrationForm.agreeTerms) }}

                <button type="submit" class="btn">Register</button>
            {{ form_end(registrationForm) }}
        </div>
    </div>

    {# Registration page styles #}
    <style>
        .register-page {
            min-height: 70vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 50px 20px;
            background: #F3E9DC;
        }

        .register-card {
            box-sizing: border-box;
            width: min(100%, 560px);
            padding: 36px;
            border: 1px solid #e5d5c3;
            border-radius: 16px;
            background: #fffaf4;
            color: #2E1F1A;
            box-shadow: 0 10px 30px rgba(46, 31, 26, 0.12);
        }

        .register-card h1 {
            margin: 0 0 28px;
            color: #2E1F1A;
            text-align: center;
        }

        .register-form .mb-3 {
            margin-bottom: 18px;
        }

        .register-form label {
            display: block;
            margin-bottom: 7px;
            color: #2E1F1A;
            font-weight: 600;
        }

        .register-form input:not([type="checkbox"]):not([type="radio"]),
        .register-form select,
        .register-form textarea {
            box-sizing: border-box;
            width: 100%;
            padding: 12px 14px;
            border: 1px solid #d8c7b5;
            border-radius: 8px;
            background: #fff;
            color: #2E1F1A;
            font: inherit;
        }

        .register-form input:focus,
        .register-form select:focus,
        .register-form textarea:focus {
            border-color: #D6A756;
            outline: 3px solid rgba(214, 167, 86, 0.2);
        }

        .register-form input[type="checkbox"],
        .register-form input[type="radio"] {
            margin-right: 8px;
            accent-color: #2E1F1A;
        }

        .register-form .form-check label {
            display: inline;
            font-weight: 400;
        }

        .register-form .btn {
            width: 100%;
            margin-top: 10px;
            padding: 13px;
            border: 0;
            border-radius: 8px;
            background: #2E1F1A;
            color: #F3E9DC;
            font: inherit;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s ease;
        }

        .register-form .btn:hover {
            background: #4a3329;
        }

        .register-card .form-errors,
        .register-card ul {
            color: #842c24;
        }

        /* Adjust the layout for small screens */
        @media (max-width: 500px) {
            .register-page {
                padding: 30px 16px;
            }

            .register-card {
                padding: 26px 20px;
            }
        }
    </style>
{% endblock %}