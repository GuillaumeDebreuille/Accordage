{% extends 'base.html.twig' %}

{% block body %}
    <main class="product-page">
        <div class="product-card">
            {% if app.user %}
                {% if 'ROLE_ADMIN' in app.user.roles %}
{# ------------------ Admin ------------------ #}
                    <h1>{{ product.name }}</h1>
                    <div>
                        <img src="{{ asset('uploads/products/' ~ product.images[0]) }}" style="width:300px; height:300px; object-fit:contain;" alt="{{ product.name }}">
                    </div>
                    <div>Catégorie :</strong> {{ product.category }}</div>
                    <div>État :</strong> {{ product.isUsed ? 'Seconde main' : 'Neuf' }}</div>
                    <div>Prix :</strong> {{ product.price }}€</div>
                    <div>Stock :</strong> {{ product.stock }}</div>
                    <div>Description :</strong> {{ product.description }}</div>
                    <a href="{{ path('app_products') }}">← Retour à la liste</a>

                    {# Start of button "add to cart" #}
                    {% set isUsed = product.isUsed %} {# Adapte la propriété selon ton entité (ex: product.state == 'used') #}
                    {% set itemType = isUsed ? 'product_used' : 'product_new' %}
                    {% if isUsed %}
                    {# used product, quantity 1 #}
                        <form action="{{ path('app_cart', { type: itemType, id: product.id }) }}" method="post">
                            <input type="hidden" name="quantity" value="1">
                            <button type="submit" class="btn btn-primary">Ajouter l'article d'occasion</button>
                        </form>
                    {% else %}
                    {# new product, quantity selectable subject to stock availability #}
                        {% if product.stock > 0 %}
                            <form action="{{ path('app_cart', { type: itemType, id: product.id }) }}" method="post">
                                <label for="quantity_{{ product.id }}">Quantité :</label>
                                <select name="quantity" id="quantity_{{ product.id }}">
                                    {% for i in 1..product.stock %}
                                        <option value="{{ i }}">{{ i }}</option>
                                    {% endfor %}
                                </select>
                                <button type="submit" class="btn btn-primary">Ajouter au panier</button>
                            </form>
                        {% else %}
                            <button class="btn btn-secondary" disabled>Rupture de stock</button>
                        {% endif %}
                    {% endif %}
                    {# End of button "add to cart" #}

                {% else %}
                    {% if app.user.verified %}
{# ------------------ Logged-in user, email verified ------------------ #}

                        <h1>{{ product.name }}</h1>
                        <div>
                            <img src="{{ asset('uploads/products/' ~ product.images[0]) }}" style="width:300px; height:300px; object-fit:contain;" alt="{{ product.name }}">
                        </div>
                        <div>Catégorie :</strong> {{ product.category }}</div>
                        <div>État :</strong> {{ product.isUsed ? 'Seconde main' : 'Neuf' }}</div>
                        <div>Prix :</strong> {{ product.price }}€</div>
                        <div>Stock :</strong> {{ product.stock }}</div>
                        <div>Description :</strong> {{ product.description }}</div>
                        <a href="{{ path('app_products') }}">← Retour à la liste</a>

                        {# Start of button "add to cart" #}
                        {% set isUsed = product.isUsed %} {# Adapte la propriété selon ton entité (ex: product.state == 'used') #}
                        {% set itemType = isUsed ? 'product_used' : 'product_new' %}
                        {% if isUsed %}
                        {# used product, quantity 1 #}
                            <form action="{{ path('app_cart', { type: itemType, id: product.id }) }}" method="post">
                                <input type="hidden" name="quantity" value="1">
                                <button type="submit" class="btn btn-primary">Ajouter l'article d'occasion</button>
                            </form>
                        {% else %}
                        {# new product, quantity selectable subject to stock availability #}
                            {% if product.stock > 0 %}
                                <form action="{{ path('app_cart', { type: itemType, id: product.id }) }}" method="post">
                                    <label for="quantity_{{ product.id }}">Quantité :</label>
                                    <select name="quantity" id="quantity_{{ product.id }}">
                                        {% for i in 1..product.stock %}
                                            <option value="{{ i }}">{{ i }}</option>
                                        {% endfor %}
                                    </select>
                                    <button type="submit" class="btn btn-primary">Ajouter au panier</button>
                                </form>
                            {% else %}
                                <button class="btn btn-secondary" disabled>Rupture de stock</button>
                            {% endif %}
                        {% endif %}
                        {# End of button "add to cart" #}

                    {% else %}
{# ------------------ Logged-in user, but email not verified ------------------ #}
                        <h3>Pour acheter un produit, merci de vérifier votre adresse mail.</h3>

                        <h1>{{ product.name }}</h1>
                        <div>
                            <img src="{{ asset('uploads/products/' ~ product.images[0]) }}" style="width:300px; height:300px; object-fit:contain;" alt="{{ product.name }}">
                        </div>
                        <div>Catégorie :</strong> {{ product.category }}</div>
                        <div>État :</strong> {{ product.isUsed ? 'Seconde main' : 'Neuf' }}</div>
                        <div>Prix :</strong> {{ product.price }}€</div>
                        <div>Stock :</strong> {{ product.stock }}</div>
                        <div>Description :</strong> {{ product.description }}</div>
                        <a href="{{ path('app_products') }}">← Retour à la liste</a>

                    {% endif %}
                {% endif %}
            {% else %}
{# ------------------ Not logged in ------------------ #}
                <h3>Pour acheter un produit, merci de vous identifier</h3>

                <h1>{{ product.name }}</h1>
                <div>
                    <img src="{{ asset('uploads/products/' ~ product.images[0]) }}" style="width:300px; height:300px; object-fit:contain;" alt="{{ product.name }}">
                </div>
                <div>Catégorie :</strong> {{ product.category }}</div>
                <div>État :</strong> {{ product.isUsed ? 'Seconde main' : 'Neuf' }}</div>
                <div>Prix :</strong> {{ product.price }}€</div>
                <div>Stock :</strong> {{ product.stock }}</div>
                <div>Description :</strong> {{ product.description }}</div>
                <a href="{{ path('app_products') }}">← Retour à la liste</a>

            {% endif %}
        </div>
    </main>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}

    <style>
        /* Product page layout */
        .product-page {
            min-height: 70vh;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            padding: 48px 20px;
        }

        /* Centered product card */
        .product-card {
            width: 100%;
            max-width: 900px;
            padding: 32px;
            background-color: #fff;
            border-radius: 16px;
            box-shadow: 0 8px 28px rgba(0, 0, 0, 0.1);
        }

        /* Product title */
        .product-card h1 {
            margin: 0 0 24px;
            text-align: center;
        }

        /* Product image */
        .product-card img {
            display: block;
            max-width: 100%;
            margin: 0 auto 24px;
            object-fit: contain;
        }

        /* Product details */
        .product-card > div {
            margin: 12px 0;
            line-height: 1.6;
        }

        /* Product forms and buttons */
        .product-card form {
            margin-top: 20px;
        }

        .product-card select {
            margin: 0 8px;
            padding: 8px;
            border: 1px solid #ced4da;
            border-radius: 6px;
        }

        /* Back link */
        .product-card > a {
            display: inline-block;
            margin-top: 16px;
        }

        /* Responsive layout for small screens */
        @media (max-width: 600px) {
            .product-page {
                padding: 24px 12px;
            }

            .product-card {
                padding: 20px;
            }
        }
    </style>
{% endblock %}