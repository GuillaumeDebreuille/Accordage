                    </form>
                    <br>

                {% elseif type == 'pack' %}

                    {{ pack.title }}
                    <img src="{{ asset('uploads/lessons/' ~ pack.image) }}" style="width:120px; height:120px; object-fit:contain;">
                    {{ pack.instrument }}
                    {{ pack.description }}

                    <br>
                    {% for lesson in lessons %}
                        {{ lesson.title }}
