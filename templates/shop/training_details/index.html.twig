{% include 'layout/header.html.twig' %}



    {% if app.user %}
        {% if 'ROLE_ADMIN' in app.user.roles %}
{# ------------------ Admin ------------------ #}
        <h3>Admin !</h3> {# A RETIRER !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! #}

        id : {{ lesson.id }} <br>
        name : {{ lesson.title }} <br>
        <img src="{{ asset('uploads/lessons/' ~ lesson.images) }}" style="width:120px; height:120px; object-fit:contain;"><br>
        description : {{ lesson.description }} <br>
        prix : {{ lesson.price }}€ <br>
        <br>





        {% else %}
            {% if app.user.verified %}
{# ------------------ Logged-in user, email verified ------------------ #}
            <h3>Connecté et mail vérifié</h3> {# A RETIRER !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! #}

                {% if type == 'lesson' %}

                    id : {{ lesson.id }} <br>
                    name : {{ lesson.title }} <br>
                    <img src="{{ asset('uploads/lessons/' ~ lesson.images) }}" style="width:120px; height:120px; object-fit:contain;"><br>
                    description : {{ lesson.description }} <br>
                    prix : {{ lesson.price }}€ <br>
                    <br>

                {% elseif type == 'pack' %}

                    {% for lesson in lessons %}
                    <li>
                        <strong>{{ lesson.title }}</strong> - {{ lesson.price }}€
                    </li>
                    {% else %}
                        <li>Aucune leçon dans ce pack pour le moment.</li>
                    {% endfor %}

                {% endif %}




            {% else %}
{# ------------------ Logged-in user, but email not verified ------------------ #}
            <h3>Connecté et mail non vérifié</h3> {# A RETIRER !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! #}
            <h3>Pour acheter un pack ou une leçon, merci de vérifier votre adresse mail.</h3>

            id : {{ lesson.id }} <br>
            name : {{ lesson.title }} <br>
            <img src="{{ asset('uploads/lessons/' ~ lesson.images) }}" style="width:120px; height:120px; object-fit:contain;"><br>
            description : {{ lesson.description }} <br>
            prix : {{ lesson.price }}€ <br>
            <br>





            {% endif %}
        {% endif %}
    {% else %}
{# ------------------ Not logged in ------------------ #}
    <h3>non connecté !</h3> {# A RETIRER !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! #}
    <h3>Pour acheter un pack ou une leçon, merci de vous identifier</h3>

    id : {{ lesson.id }} <br>
    name : {{ lesson.title }} <br>
    <img src="{{ asset('uploads/lessons/' ~ lesson.images) }}" style="width:120px; height:120px; object-fit:contain;"><br>
    description : {{ lesson.description }} <br>
    prix : {{ lesson.price }}€ <br>
    <br>





    {% endif %}


