{% block body %}
    {% if status == 'success' %}
        <h1>Paiement réussi !</h1>
        <p>Merci pour ton achat.</p>
    {% else %}
        <h1>Paiement annulé</h1>
        <p>Ta commande n'a pas été finalisée.</p>
    {% endif %}
    <a href="{{ path('app_home') }}">Retour à l'accueil</a>
{% endblock %}
