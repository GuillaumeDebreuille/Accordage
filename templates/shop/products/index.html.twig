            {% endif %}
        {% endif %}
    {% else %}
{# ------------------ Not logged in ------------------ #}
    <h3>non connecté !</h3> {# A RETIRER !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! #}
    <div class="product-notice">
        <h3>Pour acheter un pack ou une leçon, merci de vous identifier</h3>
        <a href="{{ path('app_login') }}">Se Connecter</a> -
        <a href="{{ path('app_register') }}">Créer un comtpe</a>
    </div>

    {% for product in products %}
        {% if (state == 'new' and not product.isUsed) %}
        {% if categories is empty or product.category in categories %}
            {% if not product.isUsed %}
                <article class="product-card">
                    <div class="product-card-body">
                        <h3 class="product-card-title">{{ product.name }}</h3>
