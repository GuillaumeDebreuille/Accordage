{% extends 'base.html.twig' %}

{% block title %}
    Produits à vendre
{% endblock %}

{% block body %}


{# ----- start of the sorting system ----- #}

{% set state = app.request.get('state', 'new') %}
{% set sort = app.request.get('sort', 'none') %}
{% set categories = app.request.get('categories', []) %}

{% if sort == 'asc' %}
    {% set products = products|sort((a, b) => a.price <=> b.price) %}
{% elseif sort == 'desc' %}
    {% set products = products|sort((a, b) => b.price <=> a.price) %}
{% endif %}

<div class="product-page">

    <form method="get" action="{{ path('app_products') }}" class="product-filters">

        {# 1/3 : New / Occasion #}
        <label>
            <input type="radio" name="state" value="new" onchange="this.form.submit()"
                {{ state == 'new' ? 'checked' : '' }}> Neuf
        </label>
        <label>
            <input type="radio" name="state" value="used" onchange="this.form.submit()"
                {{ state == 'used' ? 'checked' : '' }}> Seconde main
        </label>

        {# 2/3 : Catégories ( Guitar / Bass / Other ) #}
        <label>
            <input type="checkbox" name="categories[]" value="guitar" onchange="this.form.submit()"
                {{ 'guitar' in categories ? 'checked' : '' }}> Guitare
        </label>
        <label>
            <input type="checkbox" name="categories[]" value="bass" onchange="this.form.submit()"
                {{ 'bass' in categories ? 'checked' : '' }}> Basse
        </label>
        <label>
            <input type="checkbox" name="categories[]" value="other" onchange="this.form.submit()"
                {{ 'other' in categories ? 'checked' : '' }}> Autre
        </label>

        {# 3/3 : Sort by price #}
        <select name="sort" onchange="this.form.submit()">
            <option value="none" {{ sort == 'none' ? 'selected' : '' }}>Sans tri</option>
            <option value="asc" {{ sort == 'asc' ? 'selected' : '' }}>Prix croissant</option>
            <option value="desc" {{ sort == 'desc' ? 'selected' : '' }}>Prix décroissant</option>
        </select>
    </form>

    {# ----- end of the sorting system ----- #}

    {% if app.user %}
        {% if 'ROLE_ADMIN' in app.user.roles %}
{# ------------------ Admin ------------------ #}
        <h3>Admin !</h3> {# A RETIRER !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! #}

        {% for product in products %}
            {% if (state == 'new' and not product.isUsed) %}
            {% if categories is empty or product.category in categories %}
                {% if not product.isUsed %}
                    <article class="product-card">
                        <div class="product-card-body">
                            <p class="product-meta">ID : {{ product.id }}</p>
                            <h3 class="product-card-title">{{ product.name }}</h3>
                            <p class="product-category">{{ product.category }}</p>
                            <p class="product-description">{{ product.description }}</p>
                            <p class="product-price">{{ product.price }}€</p>
                            <p class="product-meta">Stock : {{ product.stock }}</p>

                            {% if product.images|length > 0 %}
                                <img src="{{ asset('uploads/products/' ~ product.images[0]) }}" class="product-image" alt="{{ product.name }}">
                            {% endif %}

                            <a class="btn product-button" href="{{ path('app_product_details', {'id': product.id}) }}">
                                Voir les détails
                            </a>

                            {# Start of button "add to cart" #}
                            {% if product.stock > 0 %}
                                <form action="{{ path('app_cart', { type: 'product_new', id: product.id }) }}" method="post" class="product-cart-form">
                                    <label for="quantity_{{ product.id }}">Quantité :</label>
                                    <select name="quantity" id="quantity_{{ product.id }}">
                                        {% for i in 1..product.stock %}
                                            <option value="{{ i }}">{{ i }}</option>
                                        {% endfor %}
                                    </select>
                                    <button type="submit" class="btn product-button">Ajouter au panier</button>
                                </form>
                            {% else %}
                                <button class="btn product-button" disabled>Rupture de stock</button>
                            {% endif %}
                            {# End of button "add to cart" #}
                        </div>
                    </article>
                {% endif %}
            {% endif %}
            {% endif %}
        {% endfor %}

        {% for product in products %}
            {% if (state == 'used' and product.isUsed) %}
            {% if categories is empty or product.category in categories %}
                {% if product.isUsed %}
                    <article class="product-card">
                        <div class="product-card-body">
