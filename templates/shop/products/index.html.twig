</div>

{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .product-page {
            max-width: 1200px;
            margin: 0 auto;
            padding: 2rem 1rem 4rem;
        }

        .product-filters {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 0.8rem 1.5rem;
            margin-bottom: 3rem;
            padding: 1.25rem 1.5rem;
            background-color: #FBF6EF;
            border-left: 5px solid #D6A756;
            border-radius: 0.75rem;
            box-shadow: 0 4px 14px rgba(46, 31, 26, 0.08);
        }

        .product-filters label {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            margin: 0;
            color: #2E1F1A;
            font-weight: 600;
            cursor: pointer;
        }

        .product-filters input {
            accent-color: #B23A2F;
        }

        .product-filters select {
            padding: 0.5rem 0.75rem;
            color: #2E1F1A;
            background-color: #fff;
            border: 1px solid #D6A756;
            border-radius: 0.4rem;
        }

        .product-card {
            display: inline-block;
            width: calc(33.333% - 1.1rem);
            margin: 0 1rem 1rem 0;
            vertical-align: top;
            overflow: hidden;
            background-color: #fff;
            border: 1px solid #E7D8C5;
            border-radius: 0.75rem;
            box-shadow: 0 4px 14px rgba(46, 31, 26, 0.08);
        }

        .product-card-body {
            display: flex;
            height: 100%;
            flex-direction: column;
            align-items: flex-start;
            padding: 1.5rem;
        }

        .product-card-title {
            margin: 0 0 0.5rem;
            color: #B23A2F;
            font-size: 1.25rem;
        }

        .product-category,
        .product-meta {
            margin: 0 0 0.5rem;
            color: #66544B;
        }

        .product-description {
            color: #2E1F1A;
        }

        .product-price {
            margin: 0.5rem 0;
            color: #2E1F1A;
            font-size: 1.2rem;
            font-weight: 700;
        }

        .product-image {
            display: block;
            width: 100%;
            height: 190px;
            margin: 0.75rem 0;
            padding: 0.75rem;
            object-fit: contain;
            background-color: #F3E9DC;
            border-radius: 0.5rem;
        }

        .product-button {
            margin-top: 0.5rem;
            color: #2E1F1A;
            background-color: #D6A756;
            border: 1px solid #D6A756;
            font-weight: 600;
        }

        .product-button:hover,
        .product-button:focus {
            color: #F3E9DC;
            background-color: #2E1F1A;
            border-color: #2E1F1A;
        }

        .product-cart-form {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 0.5rem;
            margin-top: 0.5rem;
        }

        .product-notice {
            margin: 1rem 0 2rem;
            padding: 1.25rem;
            background-color: #FBF6EF;
            border-left: 5px solid #D6A756;
            border-radius: 0.75rem;
            box-shadow: 0 4px 14px rgba(46, 31, 26, 0.08);
        }

        .product-notice a {
            color: #B23A2F;
            font-weight: 600;
            text-decoration: none;
        }

        .product-notice a:hover {
            color: #7D261F;
            text-decoration: underline;
        }

        @media (max-width: 800px) {
            .product-card {
                width: calc(50% - 1rem);
            }
        }

        @media (max-width: 576px) {
            .product-page {
                padding: 1.25rem 1rem 3rem;
            }

            .product-filters {
                gap: 0.75rem;
                padding: 1rem;
            }

            .product-card {
                width: 100%;
                margin-right: 0;
            }

            .product-card-body {
                padding: 1.2rem;
            }
        }
    </style>
{% endblock %}