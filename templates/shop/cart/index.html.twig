{% include 'layout/header.html.twig' %}

{% if cartData is empty %}
    <p>Ton panier est vide.</p>
{% else %}

    {% for item in cartData %}
    id : {{ item.element.id }} <br>
    name : {{ item.element.name ?? item.element.title }} <br>
    type : {{ item.type }} <br>
    quantity : {{ item.quantity }} <br>

    {% if item.type in ['product_new', 'product_used'] %}
        <form action="{{ path('app_cart', { type: item.type, id: item.element.id, action: 'update_quantity' }) }}" method="POST">
            <input type="number" name="quantity" value="{{ item.quantity }}" min="1" max="{{ item.element.stock }}">
            <button type="submit">Modifier la quantité</button>
            <span>(Max : {{ item.element.stock }})</span>
        </form>

        {% if item.quantity >= item.element.stock %}
            stock max <br>
        {% endif %}
    {% endif %}

    <form action="{{ path('app_cart', { type: item.type, id: item.element.id, action: 'remove' }) }}" method="POST">
        <button type="submit">Supprimer</button>
    </form>
    <br>
    {% endfor %}

{% endif %}
