
<div class="header-zone">
    <br><br> {# A RETIRER !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! #}
    {% if app.user %}
        {% if 'ROLE_ADMIN' in app.user.roles %}
        {# Admin display #}
        <h3>Admin !</h3>
        <a href="{{ path('app_home') }}">Accueil</a>
        <a href="{{ path('app_logout') }}">Se déconnecter</a>
        <a href="{{ path('app_courses') }}">Mes cours</a>
        <a href="{{ path('app_progress') }}">Mes succès</a>
        <a href="{{ path('app_trainings') }}">Leçons 🧺</a>
        <a href="{{ path('app_products') }}">Produits 🧺</a>
        <a href="{{ path('app_cart') }}">Panier 🧺</a>
        <a href="{{ path('app_home_admin') }}">Admin</a>
        



        {% else %}
            {% if app.user.verified %}
            {# Logged-in user, email verified #}
            <h3>Connecté et mail vérifié</h3>
            <a href="{{ path('app_home') }}">Accueil</a>
            <a href="{{ path('app_logout') }}">Se déconnecter</a>
            <a href="{{ path('app_courses') }}">Mes cours</a>
            <a href="{{ path('app_progress') }}">Mes succès</a>
            <a href="{{ path('app_trainings') }}">Leçons 🧺</a>
            <a href="{{ path('app_products') }}">Produits 🧺</a>
            <a href="{{ path('app_cart') }}">Panier 🧺</a>



            {% else %}
            {# Logged-in user, but email not verified #}
            <h3>Connecté et mail non vérifié</h3>
            <a href="{{ path('app_home') }}">Accueil</a>
            <a href="{{ path('app_logout') }}">Se déconnecter</a>
            <a href="{{ path('app_trainings') }}">Leçons 🧺</a>
            <a href="{{ path('app_products') }}">Produits 🧺</a>



            {% endif %}
        {% endif %}
    {% else %}
    {# Not logged in #}
    <h3>non connecté !</h3>
    <a href="{{ path('app_home') }}">Accueil</a>
    <a href="{{ path('app_login') }}">Se Connecter</a>
    <a href="{{ path('app_trainings') }}">Leçons 🧺</a>
    <a href="{{ path('app_products') }}">Produits 🧺</a>


    {% endif %}
<br><br><br> {# A RETIRER !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! #}
</div>

<style>
.header-zone {
    background-color: #d5c8c8;
    }  
body {
    margin: 0;
}
</style>