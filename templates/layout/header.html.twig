{% if app.user %}
    {% if 'ROLE_ADMIN' in app.user.roles %}
    {# Admin display #}
    <nav class="navbar navbar-expand-lg navbar-dark site-navbar sticky-top">
        <div class="container">
            <a class="navbar-brand fw-bold" href="{{ path('app_home') }}"><i class="bi bi-house-door me-1" aria-hidden="true"></i>Accordage</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainMenu" aria-controls="mainMenu" aria-expanded="false" aria-label="Ouvrir le menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainMenu">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_courses') }}"><i class="bi bi-collection-play me-1" aria-hidden="true"></i>Mes cours</a></li>
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_progress') }}"><i class="bi bi-trophy me-1" aria-hidden="true"></i>Mes succès</a></li>
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_trainings') }}"><i class="bi bi-bag me-1" aria-hidden="true"></i>Leçons</a></li>
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_products') }}"><i class="bi bi-bag me-1" aria-hidden="true"></i>Produits</a></li>
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_cart') }}"><i class="bi bi-cart3 me-1" aria-hidden="true"></i>Panier</a></li>
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_home_admin') }}"><i class="bi bi-shield-lock me-1" aria-hidden="true"></i>Admin</a></li>
                </ul>
                <ul class="navbar-nav mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_logout') }}"><i class="bi bi-box-arrow-right me-1" aria-hidden="true"></i>Se déconnecter</a></li>
                </ul>
            </div>
        </div>
    </nav>

    {% else %}
        {% if app.user.verified %}
        {# Logged-in user, email verified #}
        <nav class="navbar navbar-expand-lg navbar-dark site-navbar sticky-top">
            <div class="container">
                <a class="navbar-brand fw-bold" href="{{ path('app_home') }}"><i class="bi bi-house-door me-1" aria-hidden="true"></i>Accordage</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainMenu" aria-controls="mainMenu" aria-expanded="false" aria-label="Ouvrir le menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainMenu">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" href="{{ path('app_courses') }}"><i class="bi bi-collection-play me-1" aria-hidden="true"></i>Mes cours</a></li>
                        <li class="nav-item"><a class="nav-link" href="{{ path('app_progress') }}"><i class="bi bi-trophy me-1" aria-hidden="true"></i>Mes succès</a></li>
                        <li class="nav-item"><a class="nav-link" href="{{ path('app_trainings') }}"><i class="bi bi-bag me-1" aria-hidden="true"></i>Leçons</a></li>
                        <li class="nav-item"><a class="nav-link" href="{{ path('app_products') }}"><i class="bi bi-bag me-1" aria-hidden="true"></i>Produits</a></li>
                        <li class="nav-item"><a class="nav-link" href="{{ path('app_cart') }}"><i class="bi bi-cart3 me-1" aria-hidden="true"></i>Panier</a></li>
                    </ul>
                    <ul class="navbar-nav mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" href="{{ path('app_logout') }}"><i class="bi bi-box-arrow-right me-1" aria-hidden="true"></i>Se déconnecter</a></li>
                    </ul>
                </div>
            </div>
        </nav>

        {% else %}
        {# Logged-in user, but email not verified #}
        <nav class="navbar navbar-expand-lg navbar-dark site-navbar sticky-top">
            <div class="container">
                <a class="navbar-brand fw-bold" href="{{ path('app_home') }}"><i class="bi bi-house-door me-1" aria-hidden="true"></i>Accordage</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainMenu" aria-controls="mainMenu" aria-expanded="false" aria-label="Ouvrir le menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainMenu">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" href="{{ path('app_trainings') }}"><i class="bi bi-bag me-1" aria-hidden="true"></i>Leçons</a></li>
                        <li class="nav-item"><a class="nav-link" href="{{ path('app_products') }}"><i class="bi bi-bag me-1" aria-hidden="true"></i>Produits</a></li>
                    </ul>
                    <ul class="navbar-nav mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" href="{{ path('app_logout') }}"><i class="bi bi-box-arrow-right me-1" aria-hidden="true"></i>Se déconnecter</a></li>
                    </ul>
                </div>
            </div>
        </nav>
        {% endif %}
    {% endif %}
{% else %}
{# Not logged in #}
<nav class="navbar navbar-expand-lg navbar-dark site-navbar sticky-top">
    <div class="container">
        <a class="navbar-brand fw-bold" href="{{ path('app_home') }}"><i class="bi bi-house-door me-1" aria-hidden="true"></i>Accordage</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainMenu" aria-controls="mainMenu" aria-expanded="false" aria-label="Ouvrir le menu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainMenu">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item"><a class="nav-link" href="{{ path('app_trainings') }}"><i class="bi bi-bag me-1" aria-hidden="true"></i>Leçons</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('app_products') }}"><i class="bi bi-bag me-1" aria-hidden="true"></i>Produits</a></li>
            </ul>
            <ul class="navbar-nav mb-2 mb-lg-0">
                <li class="nav-item"><a class="nav-link" href="{{ path('app_login') }}"><i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i>Se connecter</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('app_register') }}"><i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i>Créer un compte</a></li>
            </ul>
        </div>
    </div>
</nav>
{% endif %}

<style>
    /* Navbar */
    .site-navbar {
        background-color: #2E1F1A;
        border-bottom: 3px solid #D6A756;
    }
    .site-navbar .navbar-brand {
        color: #D6A756;
    }
    .site-navbar .navbar-toggler {
        border-color: #D6A756;
    }

    /* Links */
    .site-navbar .navbar-nav .nav-link {
        color: #F3E9DC;
    }
    .site-navbar .navbar-nav .nav-link:hover {
        color: #D6A756;
    }
</style>