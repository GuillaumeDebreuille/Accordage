{% include 'layout/header.html.twig' %}


{% for lesson in lessons %}
    id : {{ lesson.id }} <br>
    name : {{ lesson.title }} <br>
    <img src="{{ asset('uploads/lessons/' ~ lesson.images) }}" style="width:120px; height:120px; object-fit:contain;"><br>
    description : {{ lesson.description }} <br>
    <a href="{{ path('app_course_details', { id: lesson.id }) }}">Voir la leçon</a>
    <br><br>
{% endfor %}
