{% include 'layout/header.html.twig' %}

<h1>Mes succès</h1>

{% for progress in progresses %}
    {{ progress.lesson.title }} - terminée le {{ progress.createdAt|date('d/m/Y') }}
    <form method="post" action="{{ path('app_progress_delete', { id: progress.id }) }}" style="display:inline;">
        <input type="hidden" name="_token" value="{{ csrf_token('delete_progress_' ~ progress.id) }}">
        <button type="submit">Retirer des succès</button>
    </form>
    <br>
{% else %}
    <p>Aucune leçon terminée pour le moment.</p>
{% endfor %}
